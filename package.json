{
  "name": "ohzi-mcp",
  "version": "0.1.0",
  "description": "MCP server for driving and observing OHZI WebGL/WebGPU experiences",
  "author": "OHZI Interactive Studio",
  "license": "MIT",
  "type": "module",
  "bin": { "ohzi-mcp": "./build/server.js" },
  "main": "./build/server.js",
  "files": ["build", "LICENSE", "package.json"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node build/server.js",
    "test": "vitest run",
    "test-watch": "vitest",
    "fix-syntax": "npx eslint src --fix || echo 'Done.'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ws": "8.21.3",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "repository": { "type": "git", "url": "git+ssh://git@github.com/ohzinteractive/mcp.git" },
  "publishConfig": { "registry": "https://registry.npmjs.org/" }
}
